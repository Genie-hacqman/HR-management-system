# Server
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_NAME=hr_saas
DB_USER=root
DB_PASSWORD=changeme
DB_CONNECTION_LIMIT=10

# JWT
JWT_ACCESS_SECRET=replace_with_a_long_random_string
JWT_REFRESH_SECRET=replace_with_a_different_long_random_string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Bcrypt
BCRYPT_SALT_ROUNDS=10

# Email (used for verification / password reset)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="HR SaaS <no-reply@hrsaas.local>"

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200

# Bootstrap super admin (only used by scripts/seedSuperAdmin.js)
SEED_ADMIN_EMAIL=superadmin@hrsaas.local
SEED_ADMIN_PASSWORD=ChangeMe123!
